# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (.env ถูก gitignore ไว้แล้ว ไม่ต้องกังวลเรื่อง commit หลุด)

# ------- เซิร์ฟเวอร์ -------
PORT=15980

# ------- OpenRouter (API เดียวที่ครอบคลุม text/image/video/tts ทั้งหมดของแพลตฟอร์ม) -------
# ผู้ใช้ทั่วไปไม่เห็น/ไม่ต้องกรอกคีย์นี้ — แอดมินตั้งครั้งเดียวที่นี่ (เหมาะกับ deploy ผ่าน Coolify/env vars)
# ถ้าตั้งค่านี้ไว้ ระบบจะ sync เข้า o_vendorConfig ให้อัตโนมัติทุกครั้งที่บูต ทับค่าที่เคยตั้งผ่านหน้าแอดมิน UI
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------- LINE Login (ใช้สำหรับสมัครสมาชิก/เข้าสู่ระบบผู้ใช้ทั่วไป กันสแปมสมัครซ้ำ) -------
# สร้างช่องทางที่ https://developers.line.biz/console/ -> Create a LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# ต้องตรงกับ Callback URL ที่ตั้งไว้ในหน้า LINE Developers Console เป๊ะๆ
LINE_LOGIN_CALLBACK_URL=http://localhost:15980/api/auth/line/callback

# ------- ตรวจสลิปโอนเงิน (สำหรับระบบเติมเครดิตผ่าน PromptPay) -------
# รองรับ SlipOK เป็นค่าเริ่มต้น (https://slipok.com) เปลี่ยนได้ถ้าจะใช้เจ้าอื่น
SLIP_VERIFY_PROVIDER=slipok
SLIP_VERIFY_API_URL=https://api.slipok.com/api/line/apikey/{branchId}
SLIP_VERIFY_API_KEY=
# PromptPay ปลายทางที่ให้ผู้ใช้โอนเข้า (เบอร์โทร/เลขบัตรประชาชน/เลขพร้อมเพย์)
PROMPTPAY_ID=

# ------- Facebook Page (ให้ผู้ใช้กดติดตามตอน onboarding) -------
FACEBOOK_PAGE_URL=https://www.facebook.com/profile.php?id=61593584207399

# ------- Supabase (ฐานข้อมูลหลัก + ระบบยืนยันตัวตน แทน SQLite เดิม) -------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string — หน้า Supabase: Project Settings -> Database -> Connection string -> URI
# (คนละอันกับ SUPABASE_URL ด้านบน! อันนั้นคือ REST API URL ส่วนนี้คือสายตรงเข้า Postgres)
SUPABASE_DB_URL=
